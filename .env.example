# Conexion comun a PostgreSQL
DB_HOST=localhost
DB_PORT=5432

# Credenciales de production
DB_PRODUCTION_NAME=destino3_db
DB_PRODUCTION_USER=tu_usuario_production
DB_PRODUCTION_PASSWORD=tu_password_production

# Compatibilidad temporal con la configuracion actual; equivale a production
DB_NAME=destino3_db
DB_USER=tu_usuario_production
DB_PASSWORD=tu_password_production

# Credenciales de demo
DB_DEMO_NAME=demo_db
DB_DEMO_USER=tu_usuario_demo
DB_DEMO_PASSWORD=tu_password_demo

# Credenciales de testing
DB_TEST_NAME=destino3_test_db
DB_TEST_USER=tu_usuario_testing
DB_TEST_PASSWORD=tu_password_testing

# APIs externas
SERPAPI_KEY=tu_serpapi_key
GEMINI_API_KEY=tu_gemini_api_key

# Entorno: development | testing | production
ENVIRONMENT=development
